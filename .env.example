# Copy this file to ".env" and fill in your real key.
# The .env file is gitignored and must NEVER be committed.

# ---- LLM provider ----
# Which provider to use: "openai" (default). Code is written to be switchable.
LLM_PROVIDER=openai

# Your OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Models (defaults are cheap + capable; override if you like)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Optional: LangSmith tracing (leave blank to use local logs instead) ----
# Get a key at https://smith.langchain.com if you want hosted traces.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multiagent-event-planner

# ---- API server (backend/server.py) ----
# MongoDB for saved plans. Leave empty to use an in-memory store (dev only).
MONGO_URL=
DB_NAME=gatherly
# Required in production: protects approve/decline, delete and the plan list.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=
# Comma-separated list of allowed web origins, e.g. https://gatherly.example
CORS_ORIGINS=*
# Plan requests allowed per client IP per minute
RATE_LIMIT_PER_MINUTE=10
# Set to true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Paused (awaiting-approval) plans are stored here so they survive restarts
CHECKPOINT_DB=data/checkpoints.sqlite
MAX_CONCURRENT_RUNS=4
RUN_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3
